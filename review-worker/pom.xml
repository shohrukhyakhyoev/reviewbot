<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.reviewbot</groupId>
    <artifactId>reviewbot-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>review-worker</artifactId>
  <packaging>jar</packaging>

  <name>reviewbot :: review-worker</name>
  <description>
    Deployable: the hand-built parallel consumer engine (spec section 8) plus the core review
    pipeline, the DLQ indexer thread and the internal /admin/** endpoints.
    Engine classes belong under dev.reviewbot.worker.engine — CI scopes its ~100% branch
    coverage rule to that package.
  </description>

  <dependencies>
    <dependency>
      <groupId>dev.reviewbot</groupId>
      <artifactId>shared</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.reviewbot</groupId>
      <artifactId>shared</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
